# Copiá este archivo a .env y completá tus claves. NUNCA subas el .env a GitHub.

# --- Pinecone (obligatorio para setup_index.py, ingest.py y evaluate.py) ---
PINECONE_API_KEY=
INDEX_NAME=orbita-handbook
PINECONE_NAMESPACE=handbook-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# PINECONE_METRIC=cosine
# PINECONE_BATCH_SIZE=100

# --- Embeddings: huggingface (local, sin API key) | gemini | openai ---
# La dimensión del índice se toma del modelo. Si lo cambiás, usá otro INDEX_NAME.
EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- LLM (solo para consultar.py --responder): gemini | openai | anthropic ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Flash Lite tiene 500 requests/día en el plan gratuito (los Flash, 20). Respaldo: gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional. Se envía a OpenAI y Gemini 2.x; con Gemini 3.x y Anthropic se ignora con un aviso.
# LLM_TEMPERATURE=0.2
# Razonamiento de Gemini 3: low | medium | high (gemini-3.6-flash solo acepta medium o high).
LLM_THINKING_LEVEL=low
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30
# Reintentos propios de la cadena ante errores transitorios (el SDK no reintenta; nunca el cupo diario).
LLM_MAX_RETRIES=2
# Cupo de requests por minuto: Flash Lite permite 15/min en el plan gratuito; se deja margen.
LLM_REQUESTS_PER_MINUTE=12

# --- Recuperación (opcional) ---
# RAG_CHUNK_SIZE=500        # tokens (500-800)
# RAG_CHUNK_OVERLAP=75
# RAG_TOP_K=5
# RAG_CANDIDATOS=10         # resultados que aporta cada retriever antes de fusionar
# RAG_PESO_BM25=0.5         # peso de BM25 en el EnsembleRetriever (el vectorial recibe 1 - peso)
