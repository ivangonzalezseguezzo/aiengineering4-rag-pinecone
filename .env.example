# Copiá este archivo a .env y completá tu clave. NUNCA subas el .env a GitHub.

# --- LLM que genera la respuesta: gemini | openai | anthropic ---
LLM_PROVIDER=gemini

# --- API keys (solo hace falta la del proveedor elegido) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Modelos (opcional; si se omiten se usan estos valores por defecto) ---
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Parámetros del LLM (opcional; validados con Pydantic) ---
# temperature (0 a 2): solo se envía a OpenAI y Gemini 2.x. Gemini 3 la ignora y
# Anthropic la rechaza, así que en esos casos se omite y se registra un warning.
# LLM_TEMPERATURE=0
# Razonamiento de Gemini 3 (no se envía a otros modelos): low | medium | high.
# Probado: low en gemini-3.5-flash-lite y gemini-3.8-flash; con gemini-3.6-flash solo se probó medium.
LLM_THINKING_LEVEL=low
# Los modelos que "piensan" (Gemini 3) gastan parte de este límite razonando: no lo bajes de ~1024
LLM_MAX_TOKENS=2048
# Timeout por request (segundos)
LLM_TIMEOUT=30
# Reintentos de la cadena ante JSON inválido y errores transitorios (el SDK no reintenta; nunca el cupo diario)
LLM_MAX_RETRIES=2
# Cupo de requests por minuto (todas las llamadas comparten el cupo).
# Plan gratuito de Gemini: 15/min en los Flash Lite (5/min en los Flash). Con 12 queda margen;
# si usás un modelo Flash, bajala a 4. Borrala si tu plan es pago.
LLM_REQUESTS_PER_MINUTE=12

# --- Embeddings: huggingface (local, sin API key) | gemini | openai ---
# Si cambiás el proveedor o el modelo, reindexá con: python ingest.py --rebuild
EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Sistema RAG (opcional) ---
# RAG_COLLECTION=orbita_handbook
# RAG_CHUNK_SIZE=500        # tokens; la consigna pide como mínimo 500
# RAG_CHUNK_OVERLAP=50      # tokens; la consigna pide como mínimo 50
# RAG_TOP_K=4               # entre 3 y 5
